# Salin file ini menjadi .env.local untuk pengembangan lokal. Isi nilainya sendiri.
# JANGAN PERNAH memasukkan nilai asli ke file ini atau ke repo.

# URL proyek Supabase (Project Settings > API > Project URL)
SUPABASE_URL=
# Service role key (Project Settings > API). RAHASIA: hanya dipakai di server.
SUPABASE_SERVICE_ROLE_KEY=
# String acak panjang untuk men-hash IP pembuat trip
IP_HASH_SALT=

# Kontak untuk lapor/minta hapus trip, tampil di footer halaman trip (mis. email).
# Berawalan NEXT_PUBLIC_: nilainya ditanam saat build, jadi redeploy setelah mengubah.
NEXT_PUBLIC_REPORT_CONTACT=
